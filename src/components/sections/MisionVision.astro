---
---
<section class="py-20 px-4 relative overflow-hidden">
  
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tight mb-4 text-cyan-400 dark:text-white">
        Nuestra Esencia
      </h2>
      <div class="h-1 w-20 bg-indigo-500 mx-auto rounded-full"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 reveal">
      
      <div class="relative group p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
        <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
          <span class="text-9xl">🎯</span>
        </div>
        
        <div class="relative z-10">
          <span class="inline-block p-3 rounded-2xl bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-300 text-3xl mb-6">
            🎯
          </span>
          <h3 class="text-2xl font-black uppercase mb-4 text-slate-900 dark:text-white">
            Misión
          </h3>
          <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            Impulsar la transformación digital y comercial en la Riviera Maya, creando un ecosistema de empresas que fusionen <strong class="text-indigo-600 dark:text-indigo-400">tecnología, servicio y creatividad</strong> para resolver problemas reales con calidad de clase mundial.
          </p>
        </div>
      </div>

      <div class="relative group p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
        <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
          <span class="text-9xl">👁️</span>
        </div>
        
        <div class="relative z-10">
          <span class="inline-block p-3 rounded-2xl bg-cyan-100 dark:bg-cyan-900/50 text-cyan-600 dark:text-cyan-300 text-3xl mb-6">
            👁️
          </span>
          <h3 class="text-2xl font-black uppercase mb-4 text-slate-900 dark:text-white">
            Visión
          </h3>
          <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            Ser el referente indiscutible de innovación en el sureste de México para 2030, consolidando a <strong class="text-cyan-600 dark:text-cyan-400">Nivara Holding</strong> como sinónimo de confianza, crecimiento sostenible y vanguardia tecnológica.
          </p>
        </div>
      </div>

    </div>

    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 text-center reveal">
      {['Innovación', 'Calidad', 'Integridad', 'Pasión'].map((valor) => (
        <div class="p-4 rounded-xl bg-slate-100 dark:bg-slate-800 border border-transparent hover:border-slate-300 dark:hover:border-slate-600 transition-colors">
          <span class="font-bold uppercase text-slate-700 dark:text-slate-300 tracking-wider">{valor}</span>
        </div>
      ))}
    </div>

  </div>
</section>