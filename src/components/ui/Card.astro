---
interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  icono?: string;
  color?: string; 
  url?: string;
}

// CORRECCIÓN AQUÍ: Agregamos 'url' al final de esta lista para poder usarlo abajo
const { id, nombre, descripcion, icono, color = '#6366f1', url } = Astro.props;
---

<a 
  href={url ? url : `#${id}`} 
  target={url ? "_blank" : "_self"}
  rel={url ? "noopener noreferrer" : ""}
  class="neon-card group relative flex flex-col justify-between overflow-hidden rounded-2xl p-6 
    transition-all duration-500 ease-out
    bg-white dark:bg-slate-900
    border border-slate-200 dark:border-slate-800
    shadow-lg hover:shadow-xl dark:shadow-none"
  style={`--neon-color: ${color};`}
>
    
    <div class="icon-container mb-6 text-5xl transition-all duration-500 group-hover:scale-110 group-hover:-translate-y-1">
       {icono}
    </div>

    <div class="z-10 relative">
        <h3 class="text-xl font-black tracking-tight mb-3 uppercase
            text-slate-900 dark:text-white transition-colors group-hover:text-[var(--neon-color)]">
            {nombre}
        </h3>
        
        <p class="text-sm font-medium leading-relaxed 
            text-slate-600 dark:text-slate-400">
            {descripcion}
        </p>
    </div>

    <div class="absolute -inset-1 bg-gradient-to-br from-[var(--neon-color)] to-transparent opacity-0 group-hover:opacity-20 blur-2xl transition-all duration-700 z-0" />
</a>

<style>
  .icon-container {
    color: var(--neon-color);
    /* En modo claro, bajamos un poco el brillo para que no se vea borroso */
    text-shadow: 0 0 5px var(--neon-color); 
  }

  /* Solo aplicamos el brillo fuerte en modo oscuro */
  :global(.dark) .icon-container {
     text-shadow: 0 0 15px var(--neon-color);
  }

  .neon-card:hover {
    border-color: var(--neon-color);
    transform: translateY(-5px) scale(1.02);
  }
</style>