---
import '../styles/global.css';

interface Props {
    title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <title>{title}</title>
        
        <script is:inline>
            // Bloque de ejecución inmediata para evitar el flash blanco al recargar
            (function() {
                const savedTheme = localStorage.getItem('theme') || 'dark';
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
        </script>
    </head>
    <body class="transition-colors duration-700">
        <slot />
    </body>
</html>

<style is:global>
    /* Configuración de colores base (Modo Claro) */
    <style is:global>
    :root {
        /* MODO DÍA: Fondo gris muy suave para que las tarjetas blancas resalten */
        background-color: #f8fafc; /* slate-50 */
        color: #0f172a; /* slate-900 */
    }

    html.dark {
        /* MODO NOCHE: Fondo negro profundo */
        background-color: #020617; /* slate-950 */
        color: #f1f5f9; /* slate-100 */
    }
    body {
        margin: 0;
        width: 100%;
        min-height: 100vh;
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* --- SISTEMA DE ANIMACIONES (REVEAL) --- */
    
    /* Estado inicial: invisible y desplazado hacia abajo */
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        filter: blur(5px); /* Añade un toque de suavidad extra */
        transition: all 0.8s ease-out;
        will-change: transform, opacity; /* Optimización para el navegador */
    }

    /* Estado final: cuando el usuario hace scroll y el script añade .active */
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
    }

    /* Desactivar animaciones si el usuario prefiere reducir el movimiento */
    @media (prefers-reduced-motion: reduce) {
        .reveal {
            transition: none;
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
